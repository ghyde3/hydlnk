{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(./scripts/init.sh)",
      "Bash(bash scripts/init.sh)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(supabase start*)",
      "Bash(supabase stop*)",
      "Bash(supabase status*)",
      "Bash(supabase db reset*)",
      "Bash(supabase test db*)",
      "Bash(supabase gen types*)",
      "Bash(supabase migration *)",
      "Bash(npx playwright *)",
      "Bash(pnpm exec playwright *)",
      "mcp__supabase-local",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep"
    ],
    "ask": [
      "Bash(supabase db push*)",
      "Bash(supabase link*)",
      "Bash(supabase config push*)",
      "Bash(gh pr merge*)",
      "Bash(vercel *)",
      "Bash(stripe *)",
      "mcp__fef92832-6d02-4698-b2ec-f2ef40930562",
      "mcp__2eeb527b-3642-49c1-b2c0-8429c867c6fd",
      "mcp__bfec649e-785c-4fec-8bd5-e5d60bcea909",
      "mcp__claude_ai_Supabase",
      "mcp__claude_ai_Vercel",
      "mcp__claude_ai_Stripe"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./supabase/.env)",
      "Bash(vercel deploy --prod*)",
      "Bash(vercel --prod*)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * main)",
      "Bash(git push * *:main)",
      "Bash(supabase db reset --linked*)",
      "Bash(supabase db reset*--db-url*)",
      "Bash(supabase migration repair*)",
      "Bash(supabase migration up*--linked*)",
      "Bash(supabase migration up*--db-url*)"
    ]
  },
  "enabledMcpjsonServers": ["supabase-local"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-files.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__bfec649e-785c-4fec-8bd5-e5d60bcea909__.*|mcp__claude_ai_Stripe__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stripe-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-and-lint.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-checks.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
