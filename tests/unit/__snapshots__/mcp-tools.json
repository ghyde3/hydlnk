  {
    "name": "set_theme",
    "title": "Change the theme",
    "scope": "hydlnk.write",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "pageId": {
          "description": "The page's id from list_pages. Leave it out only when the account has exactly one page.",
          "type": "string",
          "maxLength": 64,
          "format": "uuid"
        },
        "ifRev": {
          "description": "The rev from get_page. Pass it so a change made in the app after you read the page is not overwritten. If it no longer matches, the write is refused with conflict.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "theme": {
          "description": "A theme's name (any letter case) or id, from the system themes and your saved themes. null removes the theme and uses the default look. Applying a theme clears the page's own style values.",
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "overrides": {
          "description": "Style values to set on top of the theme, key by key.",
          "type": "object",
          "properties": {
            "bg": {
              "type": "string",
              "maxLength": 12,
              "description": "Page background color, hex like #1A2B3C."
            },
            "surface": {
              "type": "string",
              "maxLength": 12,
              "description": "Color of cards and panels."
            },
            "text": {
              "type": "string",
              "maxLength": 12,
              "description": "Text color."
            },
            "textMuted": {
              "type": "string",
              "maxLength": 12,
              "description": "Secondary text color."
            },
            "accent": {
              "type": "string",
              "maxLength": 12,
              "description": "Accent color."
            },
            "buttonBg": {
              "type": "string",
              "maxLength": 12,
              "description": "Button color."
            },
            "buttonText": {
              "type": "string",
              "maxLength": 12,
              "description": "Button text color."
            },
            "border": {
              "type": "string",
              "maxLength": 12,
              "description": "Color of lines and borders."
            },
            "fontHeading": {
              "type": "string",
              "enum": [
                "Inter",
                "DM Sans",
                "Manrope",
                "Geist",
                "Space Grotesk",
                "Outfit",
                "Sora",
                "Poppins",
                "Plus Jakarta Sans",
                "Bricolage Grotesque",
                "Instrument Serif",
                "Fraunces",
                "Playfair Display",
                "DM Serif Display",
                "Lora",
                "Cormorant Garamond",
                "Space Mono",
                "Geist Mono"
              ],
              "description": "Heading font."
            },
            "fontBody": {
              "type": "string",
              "enum": [
                "Inter",
                "DM Sans",
                "Manrope",
                "Geist",
                "Space Grotesk",
                "Outfit",
                "Sora",
                "Poppins",
                "Plus Jakarta Sans",
                "Bricolage Grotesque",
                "Instrument Serif",
                "Fraunces",
                "Playfair Display",
                "DM Serif Display",
                "Lora",
                "Cormorant Garamond",
                "Space Mono",
                "Geist Mono"
              ],
              "description": "Body font."
            },
            "scale": {
              "type": "number",
              "description": "Text size, 0.8 to 1.3."
            },
            "weightHeading": {
              "type": "number",
              "description": "Heading boldness: 400, 500, 600 or 700."
            },
            "letterCase": {
              "type": "string",
              "maxLength": 20,
              "description": "Capital letters: normal, uppercase or lowercase."
            },
            "radius": {
              "type": "number",
              "description": "Corner radius, 0 to 32."
            },
            "borderWidth": {
              "type": "number",
              "description": "Border thickness, 0 to 4."
            },
            "buttonStyle": {
              "type": "string",
              "maxLength": 20,
              "description": "fill, outline, soft, shadow or pill."
            },
            "density": {
              "type": "string",
              "maxLength": 20,
              "description": "Space between blocks: compact, regular or airy."
            },
            "maxWidth": {
              "type": "number",
              "description": "Page width, 360 to 720."
            },
            "align": {
              "type": "string",
              "maxLength": 20,
              "description": "Text alignment: left or center."
            },
            "bgType": {
              "type": "string",
              "maxLength": 20,
              "description": "Background: solid or gradient."
            },
            "gradientAngle": {
              "type": "number",
              "description": "Gradient direction in degrees: 0, 45, 90, 135, 180, 225, 270 or 315."
            },
            "gradientFrom": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 12
                },
                {
                  "type": "null"
                }
              ],
              "description": "Gradient start color, or null to follow the page."
            },
            "gradientTo": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 12
                },
                {
                  "type": "null"
                }
              ],
              "description": "Gradient end color, or null to follow the page."
            }
          },
          "additionalProperties": {}
        },
        "clearOverrides": {
          "description": "Remove the page's own style values first.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
