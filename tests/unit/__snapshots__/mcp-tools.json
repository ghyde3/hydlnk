  {
    "name": "get_page",
    "title": "Get a page",
    "scope": "hydlnk.read",
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "pageId": {
          "description": "The page's id from list_pages. Leave it out only when the account has exactly one page.",
          "type": "string",
          "maxLength": 64,
          "format": "uuid"
        },
        "blockId": {
          "description": "Return only this block, in full. Leave it out to get the whole page.",
          "type": "string",
          "maxLength": 40
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "get_analytics",
    "title": "Get page analytics",
    "scope": "hydlnk.read",
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "pageId": {
          "description": "The page's id from list_pages. Leave it out only when the account has exactly one page.",
          "type": "string",
          "maxLength": 64,
          "format": "uuid"
        },
        "range": {
          "description": "The period, ending today: 7d, 30d (the default), 90d or 1y. Free accounts keep 30 days.",
          "type": "string",
          "enum": [
            "7d",
            "30d",
            "90d",
            "1y"
          ]
        }
      },
      "additionalProperties": false
    }
