  {
    "name": "update_profile",
    "title": "Update the profile",
    "scope": "hydlnk.write",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "pageId": {
          "description": "The page's id from list_pages. Leave it out only when the account has exactly one page.",
          "type": "string",
          "maxLength": 64,
          "format": "uuid"
        },
        "ifRev": {
          "description": "The rev from get_page. Pass it so a change made in the app after you read the page is not overwritten. If it no longer matches, the write is refused with conflict.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "name": {
          "description": "The display name, 1 to 60 characters, on one line.",
          "type": "string",
          "maxLength": 120
        },
        "bio": {
          "description": "The bio, up to 160 characters, on one line. An empty string clears it.",
          "type": "string",
          "maxLength": 320
        },
        "photo": {
          "description": "{ imageId } to use a photo that is already on one of your pages, or null to remove the photo.",
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "imageId": {
                  "type": "string",
                  "maxLength": 100
                }
              },
              "required": [
                "imageId"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "photoShape": {
          "description": "The photo's shape.",
          "type": "string",
          "enum": [
            "circle",
            "rounded",
            "square"
          ]
        },
        "photoSize": {
          "description": "The photo's size.",
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "photoBorder": {
          "description": "The photo's border. page follows the theme.",
          "type": "string",
          "enum": [
            "page",
            "none",
            "thin",
            "thick"
          ]
        },
        "showPhoto": {
          "description": "Whether the photo shows on the page.",
          "type": "boolean"
        },
        "showName": {
          "description": "Whether the display name shows on the page.",
          "type": "boolean"
        },
        "showBio": {
          "description": "Whether the bio shows on the page.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "add_block",
    "title": "Add a block",
    "scope": "hydlnk.write",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "pageId": {
          "description": "The page's id from list_pages. Leave it out only when the account has exactly one page.",
          "type": "string",
          "maxLength": 64,
          "format": "uuid"
        },
        "ifRev": {
          "description": "The rev from get_page. Pass it so a change made in the app after you read the page is not overwritten. If it no longer matches, the write is refused with conflict.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "type": "string",
          "enum": [
            "link",
            "card",
            "header",
            "text",
            "image",
            "social",
            "embed",
            "grid",
            "divider",
            "faq",
            "contact",
            "discount",
            "book",
            "apps",
            "map"
          ],
          "description": "The kind of block to add."
        },
        "fields": {
          "description": "The block's content, using only the field names listed in this tool's description for that type. Images are imageIds from get_page. A social icon platform is one of instagram, tiktok, youtube, x, facebook, linkedin, github, threads, reddit, snapchat, pinterest, discord, twitch, spotify, email, website. A book store is amazon, apple or bookshop. An app store is appstore or googleplay. A divider needs no fields.",
          "type": "object",
          "properties": {},
          "additionalProperties": {}
        },
        "visible": {
          "description": "Whether the block shows on the page. Defaults to true. A hidden block can stay incomplete.",
          "type": "boolean"
        },
        "position": {
          "description": "Where to put the block. Defaults to the end.",
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "0 puts it first. The number of blocks puts it last."
                }
              },
              "required": [
                "index"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "afterBlockId": {
                  "type": "string",
                  "maxLength": 40,
                  "description": "Put the new block right after this block."
                }
              },
              "required": [
                "afterBlockId"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "update_block",
    "title": "Update a block",
    "scope": "hydlnk.write",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "pageId": {
          "description": "The page's id from list_pages. Leave it out only when the account has exactly one page.",
          "type": "string",
          "maxLength": 64,
          "format": "uuid"
        },
        "ifRev": {
          "description": "The rev from get_page. Pass it so a change made in the app after you read the page is not overwritten. If it no longer matches, the write is refused with conflict.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "blockId": {
          "type": "string",
          "maxLength": 40,
          "description": "The block's id from get_page."
        },
        "fields": {
          "description": "Only the fields to change, with the names add_block takes for this block's type. A field you leave out stays as it is. null clears an optional image or link field. A list (icons, cells, items, links) replaces the list: send each item's own id to keep it, so its click history stays. overrides merge key by key and null removes one.",
          "type": "object",
          "properties": {},
          "additionalProperties": {}
        },
        "visible": {
          "description": "Show or hide the block on the page.",
          "type": "boolean"
        }
      },
      "required": [
        "blockId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "move_block",
    "title": "Move a block",
    "scope": "hydlnk.write",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "pageId": {
          "description": "The page's id from list_pages. Leave it out only when the account has exactly one page.",
          "type": "string",
          "maxLength": 64,
          "format": "uuid"
        },
        "ifRev": {
          "description": "The rev from get_page. Pass it so a change made in the app after you read the page is not overwritten. If it no longer matches, the write is refused with conflict.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "blockId": {
          "type": "string",
          "maxLength": 40,
          "description": "The block to move, from get_page."
        },
        "toIndex": {
          "description": "The block's new place in the list, counting from 0, where the block ends up.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "afterBlockId": {
          "description": "Put the block right after this other block.",
          "type": "string",
          "maxLength": 40
        },
        "position": {
          "description": "Move the block to the top or the bottom.",
          "type": "string",
          "enum": [
            "first",
            "last"
          ]
        }
      },
      "required": [
        "blockId"
      ],
      "additionalProperties": false
    }
  },
