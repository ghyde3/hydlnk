# HYDLNK environment variables.
#
# Local: scripts/init.sh writes .env.local from `supabase status`, so you normally do not copy this
# file. Production: the values live in the Vercel project settings (the Supabase integration injects
# the Supabase ones). The legacy *_ANON_KEY / SERVICE_ROLE / JWT_SECRET variables are not used.
# Never commit real values; .env.local is git-ignored.

# --- Public: inlined into the browser bundle, safe to expose ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Host routing key: "localhost:3000" locally, "hydlnk.com" in production. No scheme, no path.
# Local hosts: localhost:3000 (marketing), app.localhost:3000 (editor), mara.localhost:3000 (tenant).
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# OAuth client id of the Google "Sign in with Google" button (Google Identity Services). Public by design.
# It must be the Web client id registered in Supabase's Google provider (Client IDs list, "Skip nonce
# checks" OFF). Optional: when unset the Google button is hidden and email sign-in works alone. It is
# inlined at build time, so set it for Production only and redeploy. Locally scripts/init.sh writes a
# placeholder (the Playwright specs stub Google's script); use the real id only to try the real popup.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Server only: never import into client code ----------------------------------------------
# Bypasses RLS. Used by src/lib/supabase/admin.ts (marked server-only).
SUPABASE_SECRET_KEY=sb_secret_replace_me

# --- Milestone 4: Stripe (HYDLNK sandbox only), Vercel domains, cron and analytics --------------
# Required wherever VERCEL_ENV is set (every Vercel build and deployment), except VERCEL_API_TOKEN;
# optional locally until the feature that reads them runs. scripts/init.sh writes local placeholders
# to .env.local.
# Stripe secret key. A sandbox key (sk_test_ or rk_test_) everywhere by default: a live key (sk_live_,
# rk_live_) is refused at startup unless STRIPE_LIVE_MODE=true and VERCEL_ENV=production (see below).
STRIPE_SECRET_KEY=sk_test_replace_me
# "true" or "false", default "false". The one switch to live Stripe. With "true" the key must be a live
# key and the deployment must be production (VERCEL_ENV=production): a live key anywhere else, and a
# test key in live mode, both fail validation, so live and sandbox are never mixed. Leave "false" until
# the move to Vercel Pro; the price ids and the webhook secret must then be the live ones too.
STRIPE_LIVE_MODE=false
# "true" or "false", default "true". With "false" the Upgrade buttons are disabled and read
# "Paid plans open soon" (plan cards and prices stay), and POST /api/billing/checkout answers 403
# plans_closed without calling Stripe. Anything but "true" or "false" fails validation.
PAID_PLANS_OPEN=true
# Signing secret of the webhook endpoint (whsec_..., from `stripe listen` locally).
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Sandbox price id of Pro, billed monthly (lookup key pro_monthly; $9/mo, docs/PLAN.md).
STRIPE_PRICE_PRO_MONTHLY=price_replace_me
# Sandbox price id of Pro, billed yearly (lookup key pro_yearly; $60/yr).
STRIPE_PRICE_PRO_YEARLY=price_replace_me
# Sandbox price id of Studio, billed monthly (lookup key studio_monthly; $20/mo).
STRIPE_PRICE_STUDIO_MONTHLY=price_replace_me
# Sandbox price id of Studio, billed yearly (lookup key studio_yearly; $180/yr, docs/PLAN.md).
STRIPE_PRICE_STUDIO_YEARLY=price_replace_me
# Vercel REST API token that may manage the project's domains. Optional: builds and startup do not need
# it (production has none until the custom-domains wave). Adding or removing a custom domain fails
# closed with a clear error while it is unset; deleting an account or page with no domains never needs it.
VERCEL_API_TOKEN=replace_me
# Id of the Vercel project the custom domains are attached to.
VERCEL_PROJECT_ID=replace_me
# Id of the Vercel team that owns the project.
VERCEL_TEAM_ID=replace_me
# Bearer secret Vercel Cron sends to /api/cron/*.
CRON_SECRET=replace_me
# Secret for the visitor hash behind unique-visitor counts.
VISITOR_HASH_SECRET=replace_me
# Test-only: point the Vercel client at a local stub. Refused when VERCEL_ENV=production.
# VERCEL_API_BASE_URL=http://127.0.0.1:12112
# Test-only: point the Stripe SDK at a local stub (host:port). Refused when VERCEL_ENV=production.
# STRIPE_API_HOST=127.0.0.1:12111

# --- Milestone 5: admin area and suspension ---------------------------------------------------
# Comma-separated auth user UUIDs that may use /admin (M5-04). Empty or unset means nobody is an admin.
# Production: your own id, from `select id from auth.users where email = '<your address>';`.
ADMIN_USER_IDS=
# Where a suspended owner is told to write to appeal (M5-09). Defaults to support@hydlnk.com.
SUPPORT_EMAIL=support@hydlnk.com
